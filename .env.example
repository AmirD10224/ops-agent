# OpsAgent. environment variables
# Copy to .env and fill in. NEVER commit .env.

# --- Required for live runs ---
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# --- Tracing (optional but recommended) ---
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Models ---
PLANNER_MODEL=claude-haiku-4-5-20251001
SYNTHESIZER_MODEL=claude-sonnet-4-6
CRITIC_MODEL=claude-sonnet-4-6

# --- Behavior ---
MAX_CRITIC_RETRIES=1
CONFIDENCE_THRESHOLD=0.7
HTTP_TIMEOUT_SECONDS=15
TAVILY_MAX_RESULTS=8

# --- Storage ---
SQLITE_PATH=./data/ops_agent.db
# Use DELETE on network-backed volumes (Modal, EFS) where WAL files can be lost.
SQLITE_JOURNAL_MODE=WAL

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Exact-match origins (comma-separated). Wildcards do NOT work here.
CORS_ORIGINS=http://localhost:3000
# Optional Python-style regex for CORS (e.g. Vercel previews).
# CORS_ORIGIN_REGEX=https://[a-z0-9-]+\.vercel\.app

# --- Frontend (Next.js). set in frontend/.env.local ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
